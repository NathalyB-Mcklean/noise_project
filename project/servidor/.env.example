# =============================================
# VARIABLES DE ENTORNO — AcústicaPTY
# Copia este archivo como .env y completa los valores
# NUNCA subas el archivo .env a GitHub
# =============================================

# HiveMQ Cloud (hivemq.com/mqtt-cloud)
MQTT_HOST=TU_HOST.s1.eu.hivemq.cloud
MQTT_USER=TU_USUARIO_HIVEMQ
MQTT_PASS=TU_CONTRASEÑA_HIVEMQ

# Email para alertas (usa una App Password de Gmail)
# Guía: myaccount.google.com → Seguridad → Contraseñas de aplicación
ALERT_EMAIL=tu_correo@gmail.com
EMAIL_PASS=xxxx_xxxx_xxxx_xxxx
ALERT_TO=autoridades@alcaldiadepanama.gob.pa

# Puerto del servidor
PORT=3000

# Firebase (opcional)
# FIREBASE_URL=https://TU_PROYECTO.firebaseio.com
